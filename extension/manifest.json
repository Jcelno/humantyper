{
  "manifest_version": 3,
  "name": "humantyper helper",
  "version": "1.0.0",
  "description": "Lets the humantyper website type your text into a Google Doc.",
  "key": "",
  "permissions": [
    "debugger",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "humantyper",
    "default_popup": "popup.html"
  },
  "externally_connectable": {
    "matches": [
      "https://jcelno.github.io/*",
      "http://localhost/*",
      "http://127.0.0.1/*"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://docs.google.com/document/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
